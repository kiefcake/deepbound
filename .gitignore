# ---------------------------------------------------------------------------
# Unity generated folders. These are all reproducible from Assets/ +
# ProjectSettings/ + Packages/, and Library/ in particular is several GB.
# ---------------------------------------------------------------------------
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset packs are downloaded, not authored. See docs/ASSET_SOURCES.md for what
# to download and where it goes. Tracking a few hundred MB of third-party
# binaries would bloat the repo and slow every clone.
/Assets/Art/_Downloads/
/Assets/Art/**/*.zip

# ---------------------------------------------------------------------------
# Autogenerated IDE / project files
# ---------------------------------------------------------------------------
.vs/
.vscode/
.idea/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ---------------------------------------------------------------------------
# Unity crash / analytics artifacts
# ---------------------------------------------------------------------------
sysinfo.txt
crashlytics-build.properties
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
*.apk
*.aab
*.unitypackage
*.app
*.exe

# ---------------------------------------------------------------------------
# Steam
# steam_appid.txt is a local dev file naming the App ID the build connects as.
# It must not ship and must not be committed -- it is per-developer.
# ---------------------------------------------------------------------------
steam_appid.txt
/[Ss]team[Bb]uild/

# ---------------------------------------------------------------------------
# Local tooling output
# ---------------------------------------------------------------------------
*.log
/bootstrap.log
/unity_create.log

# ---------------------------------------------------------------------------
# OS files
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
